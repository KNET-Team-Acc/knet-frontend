# Copia este archivo a .env.local para personalizarlo (Vite lo lee al arrancar).

# URL de la API de KNET (knet-backend). Déjala vacía (VITE_API_URL=) para usar solo datos locales,
# por ejemplo en un deploy estático sin backend: no se pide cuenta y todo queda en el navegador.
# Con API, entrar al panel pasa por la cuenta KNET (correo + contraseña o LinkedIn); «Continuar sin
# cuenta» mantiene el modo local.
VITE_API_URL=http://localhost:4000

# Solo desarrollo (npm run dev) y sin sesión iniciada: UUID del usuario de la API para este navegador
# (lo imprime `npm run db:seed` en knet-backend). Vacío = el backend usa su usuario demo (DEMO_USER_EMAIL).
# En el build de producción se ignora: allí la identidad es siempre el token de la sesión.
VITE_DEMO_USER_ID=
