# Copia este archivo a .env.local para personalizarlo (Vite lo lee al arrancar).

# URL de la API de KNET (backend/). Déjala vacía (VITE_API_URL=) para usar solo datos locales,
# por ejemplo en un deploy estático sin backend.
VITE_API_URL=http://localhost:4000

# Opcional: UUID del usuario de la API para este navegador (lo imprime `npm run db:seed` en backend/).
# Si se deja vacío, el backend usa su usuario demo (DEMO_USER_EMAIL).
VITE_DEMO_USER_ID=
